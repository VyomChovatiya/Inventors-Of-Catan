{
  "name": "catan-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./packages/*\" dev",
    "dev:server": "pnpm --filter @catan/server dev",
    "dev:client": "pnpm --filter @catan/client dev",
    "build": "pnpm --recursive run build",
    "start": "node packages/server/dist/index.js",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
